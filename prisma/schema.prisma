// Kütüphane Yönetim Sistemi — veritabanı şeması
// Tasarım gerekçeleri: docs/03-veritabani-tasarimi.md
//
// NOT: CHECK kısıtları ve kısmi (partial) unique index'ler Prisma şema DSL'i ile
// ifade edilemez. Bunlar migration SQL'ine elle eklenmiştir; ayrıntı için
// prisma/migrations/*/migration.sql dosyasının sonundaki "MANUEL DDL" bölümüne
// ve docs/03-veritabani-tasarimi.md §6'ya bakınız.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Prisma 7: bağlantı URL'i artık burada değil, prisma.config.ts içinde tanımlanır.
// Çalışma zamanında PrismaClient'a @prisma/adapter-pg üzerinden verilir
// (bkz. src/prisma/prisma.service.ts).
datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm]
}

// ---------------------------------------------------------------- enums

enum RoleName {
  USER
  ADMIN

  @@map("role_name")
}

enum BorrowingStatus {
  BORROWED
  RETURNED
  LATE

  @@map("borrowing_status")
}

enum ReservationStatus {
  PENDING
  READY
  FULFILLED
  CANCELLED
  EXPIRED

  @@map("reservation_status")
}

// ---------------------------------------------------- kimlik & yetki

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash") @db.VarChar(72)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles    UserRole[]
  borrowings   Borrowing[]
  reservations Reservation[]
  reviews      Review[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?  @db.VarChar(255)

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ------------------------------------------------------------- katalog

model Author {
  id        Int       @id @default(autoincrement())
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  biography String?   @db.Text
  birthDate DateTime? @map("birth_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookAuthors BookAuthor[]

  @@map("authors")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookCategories BookCategory[]

  @@map("categories")
}

model Publisher {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(150)
  website   String?  @db.VarChar(255)
  address   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  books Book[]

  @@map("publishers")
}

model Book {
  id     Int     @id @default(autoincrement())
  title  String  @db.VarChar(255)
  /// NULL'a izin verilir; PostgreSQL'de UNIQUE birden fazla NULL kabul eder,
  /// böylece ISBN'i olmayan kitaplar da eklenebilir (BR-02.1).
  isbn   String? @unique @db.VarChar(20)
  publisherId   Int  @map("publisher_id")
  publishedYear Int? @map("published_year") @db.SmallInt

  /// Kütüphanedeki toplam kopya sayısı.
  totalCopies Int @default(0) @map("total_copies")
  /// Şu anda rafta olan kopya sayısı. CHECK ile >= 0 garanti altındadır (BR-03.2).
  availableCopies Int @default(0) @map("available_copies")

  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  publisher      Publisher      @relation(fields: [publisherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookAuthors    BookAuthor[]
  bookCategories BookCategory[]
  borrowings     Borrowing[]
  reservations   Reservation[]
  reviews        Review[]

  @@index([publisherId])
  @@index([title])
  @@map("books")
}

model BookAuthor {
  bookId   Int @map("book_id")
  authorId Int @map("author_id")

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

model BookCategory {
  bookId     Int @map("book_id")
  categoryId Int @map("category_id")

  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([bookId, categoryId])
  @@index([categoryId])
  @@map("book_categories")
}

// ------------------------------------------- ödünç & rezervasyon

model Borrowing {
  id     Int             @id @default(autoincrement())
  userId Int             @map("user_id")
  bookId Int             @map("book_id")
  status BorrowingStatus @default(BORROWED)

  borrowedAt DateTime  @default(now()) @map("borrowed_at") @db.Timestamptz(3)
  dueDate    DateTime  @map("due_date") @db.Timestamptz(3)
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Ödünç kayıtları muhasebe verisidir; kullanıcı veya kitap silinse bile
  /// geçmiş korunmalıdır — bu yüzden Restrict.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("borrowings")
}

model Reservation {
  id     Int               @id @default(autoincrement())
  userId Int               @map("user_id")
  bookId Int               @map("book_id")
  status ReservationStatus @default(PENDING)

  /// Kitap içindeki FIFO sıra numarası (BR-04.2).
  queuePosition Int       @map("queue_position")
  reservedAt    DateTime  @default(now()) @map("reserved_at") @db.Timestamptz(3)
  /// READY durumuna geçtikten sonraki son alma tarihi (BR-04.5).
  readyUntil    DateTime? @map("ready_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // BR-04.1'in benzersizlik kısıtı KISMİ olmak zorundadır (yalnızca
  // PENDING/READY satırları) — Prisma bunu ifade edemediği için
  // migration SQL'ine elle eklenmiştir.
  @@index([userId])
  @@index([bookId])
  @@map("reservations")
}

// --------------------------------------------------------------- yorum

model Review {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  bookId Int @map("book_id")

  /// 1-5 aralığı CHECK kısıtı ile zorlanır (BR-05.1).
  rating  Int     @db.SmallInt
  comment String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// BR-05.2 — kullanıcı başına kitaba tek yorum.
  @@unique([userId, bookId])
  @@index([bookId])
  @@map("reviews")
}
