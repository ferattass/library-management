# --- PostgreSQL ---
POSTGRES_USER=kutupyonet
POSTGRES_PASSWORD=kutupyonet
POSTGRES_DB=kutupyonet
# 5432 ve 5433 bu makinede başka projelerce kullanılıyor.
POSTGRES_PORT=5434

# --- Uygulama ---
NODE_ENV=development
PORT=3000

# Host'tan (docker dışı) çalıştırırken: @localhost
# Konteyner içinden çalışırken:        @postgres  (compose bunu kendisi geçer)
DATABASE_URL=postgresql://kutupyonet:kutupyonet@localhost:5434/kutupyonet?schema=public

# --- Auth ---
# Üretimde mutlaka değiştirin:  openssl rand -base64 48
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
